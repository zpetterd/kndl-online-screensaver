#!/bin/sh
# shellcheck disable=SC2034
#############################################################################
### KNDL-ONLINE-SCREENSAVER CONFIGURATION SETTINGS
### Generated by install.sh — edit as needed.
#############################################################################

DEFAULTINTERVAL=300

SCHEDULE="@@SCHEDULE@@"

IMAGE_URI="@@IMAGE_URI@@"

# Auto-detect device model, screen resolution, and screensaver filename.
if [ -e "device.sh" ]; then
	# shellcheck disable=SC1091
	. ./device.sh
	get_device_info
fi

SCREENSAVERFOLDER=/mnt/us/linkss/screensavers/
SCREENSAVERFILE=${SCREENSAVERFOLDER}/${SCREENSAVER_BASENAME:-bg_ss00.png}

LOGGING=0
LOGFILE=/dev/stderr

REQUEST_RESIZE=@@REQUEST_RESIZE@@

DISABLE_WIFI=@@DISABLE_WIFI@@

TEST_DOMAIN="8.8.8.8"
NETWORK_TIMEOUT=58

#############################################################################
# Advanced
#############################################################################

RTC=0
TMPFILE=/tmp/tmp.onlinescreensaver.png
